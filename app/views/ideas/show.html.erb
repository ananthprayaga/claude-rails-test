<% content_for :title, "#{@idea.title} · Idea Vault" %>
<% not_set = tag.span("Not decided yet", class: "text-stone-500 dark:text-stone-400") %>

<%= link_to ideas_path, class: "sheet-tab link" do %><%= icon(:arrow_left, class: "size-5") %> All ideas<% end %>
<article class="sheet">
  <header>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= star_button(@idea, labelled: true) %>
      <%= link_to edit_idea_path(@idea), class: "btn" do %><%= icon(:pencil, class: "size-5") %> Edit<% end %>
      <%= button_to @idea, method: :delete, class: "btn btn-quiet btn-quiet-danger", form_class: "inline",
                    data: { turbo_confirm: "Delete \"#{@idea.title}\"? This can't be undone." } do %>
        <%= icon(:trash, class: "size-5") %> Delete
      <% end %>
    </div>
    <h1 class="mt-8 text-4xl font-extrabold"><%= @idea.title %></h1>
    <div class="mt-4 flex flex-wrap items-center gap-4">
      <%= status_badge(@idea) %>
      <%= potential_stars(@idea.potential) %>
      <% if @idea.category.present? %>
        <%= link_to @idea.category, ideas_path(category: @idea.category), class: "link text-sm" %>
      <% end %>
    </div>
    <p class="mt-4 text-sm text-stone-600 dark:text-stone-400">
      Added <%= @idea.created_at.to_date.to_fs(:long) %> · last updated <%= time_ago_in_words(@idea.updated_at) %> ago
    </p>
  </header>

  <section class="mt-16">
    <h2 class="eyebrow">The idea</h2>
    <% if @idea.description.present? %>
      <div class="mt-4 max-w-[65ch] space-y-4 text-xl leading-relaxed"><%= simple_format @idea.description %></div>
    <% else %>
      <p class="mt-4 text-stone-600 dark:text-stone-400">No description yet. <%= link_to "Add one", edit_idea_path(@idea), class: "link" %></p>
    <% end %>
  </section>

  <div class="mt-16 grid gap-8 sm:grid-cols-2">
    <section>
      <h2 class="eyebrow">Who it's for</h2>
      <p class="mt-2 text-xl"><%= @idea.target_market.presence || not_set %></p>
    </section>
    <section>
      <h2 class="eyebrow">How it makes money</h2>
      <p class="mt-2 text-xl"><%= @idea.revenue_model.presence || not_set %></p>
    </section>
  </div>

  <% if @idea.notes.present? %>
    <section class="mt-16">
      <h2 class="eyebrow">Notes</h2>
      <div class="mt-4 max-w-[65ch] space-y-4 leading-relaxed"><%= simple_format @idea.notes %></div>
    </section>
  <% end %>
</article>
