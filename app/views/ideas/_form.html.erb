<%= form_with(model: idea, class: "space-y-8") do |form| %>
  <% if idea.errors.any? %>
    <div class="rounded-lg border border-red-300 bg-red-50 p-4 text-base text-red-800 dark:border-red-900 dark:bg-red-950 dark:text-red-200" role="alert">
      <p class="font-semibold">Please fix <%= idea.errors.count == 1 ? "this" : "these" %> before saving:</p>
      <ul class="mt-2 list-disc pl-6">
        <% idea.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Idea name", class: "label" %>
    <%= form.text_field :title, class: "input py-3 text-2xl font-bold", placeholder: "e.g. Subscription box for houseplants", autofocus: idea.new_record? %>
  </div>

  <div>
    <%= form.label :description, "What's the idea?", class: "label" %>
    <%= form.textarea :description, rows: 5, class: "input leading-relaxed", placeholder: "The problem, your solution, and why now" %>
  </div>

  <div class="max-w-sm">
    <%= form.label :status, "Where is it at?", class: "label" %>
    <%= form.select :status, Idea::STATUSES.invert, {}, class: "input" %>
  </div>

  <div class="max-w-sm">
    <%= form.label :potential, "How big could it be?", class: "label" %>
    <%= form.select :potential, potential_options, {}, class: "input" %>
  </div>

  <div class="max-w-sm">
    <%= form.label :category, class: "label" %>
    <%= form.text_field :category, class: "input", list: "category-options", placeholder: "e.g. SaaS" %>
    <datalist id="category-options">
      <% Idea.categories.each do |c| %><option value="<%= c %>"><% end %>
    </datalist>
    <p class="hint">Pick one you've used before or type a new one.</p>
  </div>

  <div>
    <%= form.label :target_market, "Who is it for?", class: "label" %>
    <%= form.text_field :target_market, class: "input", placeholder: "e.g. Freelance designers" %>
  </div>

  <div>
    <%= form.label :revenue_model, "How will it make money?", class: "label" %>
    <%= form.text_field :revenue_model, class: "input", placeholder: "e.g. $10 monthly subscription" %>
  </div>

  <div>
    <%= form.label :notes, class: "label" %>
    <%= form.textarea :notes, rows: 4, class: "input leading-relaxed", placeholder: "Competitors, links, next steps" %>
  </div>

  <label class="flex items-center gap-2 text-base font-semibold">
    <%= form.check_box :starred, class: "size-5 rounded accent-brand-600" %> Star this idea
  </label>

  <div class="flex flex-wrap items-center gap-4 pt-8">
    <%= form.submit idea.new_record? ? "Save idea" : "Save changes", class: "btn btn-primary btn-lg" %>
    <%= link_to "Cancel", idea.new_record? ? ideas_path : idea, class: "link" %>
  </div>
<% end %>
