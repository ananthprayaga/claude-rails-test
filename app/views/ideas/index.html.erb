<% content_for :title, "Idea Vault" %>
<% filtering = params.values_at(:q, :status, :category, :starred).any?(&:present?) %>

<div class="text-center">
  <h1 class="text-4xl font-black tracking-tight sm:text-5xl">
    <%= params[:starred] == "1" ? "Starred ideas" : "Your business ideas" %>
  </h1>
  <p class="mt-2 text-stone-500 dark:text-stone-400">
    <%= pluralize(@total_count, "idea") %> captured · <%= @status_counts.fetch("launched", 0) %> launched
  </p>
  <div class="mt-5 flex justify-center">
    <%= link_to "+ New idea", new_idea_path, class: "btn btn-go px-5 py-2 text-base" %>
  </div>
</div>

<%= form_with url: ideas_path, method: :get, class: "mx-auto mt-8 flex max-w-3xl flex-wrap items-center justify-center gap-2", data: { turbo_action: "advance" } do |f| %>
  <%= f.hidden_field :status, value: params[:status] if params[:status].present? %>
  <%= f.hidden_field :starred, value: "1" if params[:starred] == "1" %>
  <%= f.search_field :q, value: params[:q], placeholder: "Find an idea…", class: "input flex-1 basis-64 rounded-full px-4" %>
  <%= f.select :category, options_for_select(@categories, params[:category]), { include_blank: "All categories" }, class: "input w-auto rounded-full" %>
  <%= f.select :sort, options_for_select([["Newest", "newest"], ["Oldest", "oldest"], ["Highest potential", "potential"], ["Recently updated", "updated"], ["Title A–Z", "title"]], params[:sort]), {}, class: "input w-auto rounded-full" %>
  <%= f.submit "Search", class: "btn", name: nil %>
<% end %>

<nav class="mt-5 flex flex-wrap justify-center gap-1">
  <%= link_to ideas_path(request.query_parameters.except(:status)), class: ["pill-tab", ("pill-tab-active" if params[:status].blank?)] do %>
    All <span class="opacity-60"><%= @total_count %></span>
  <% end %>
  <% Idea::STATUSES.each do |key, label| %>
    <%= link_to ideas_path(request.query_parameters.merge(status: key)), class: ["pill-tab", ("pill-tab-active" if params[:status] == key)] do %>
      <%= label %> <span class="opacity-60"><%= @status_counts.fetch(key, 0) %></span>
    <% end %>
  <% end %>
</nav>

<% if @ideas.any? %>
  <% if filtering %>
    <h2 class="divider"><%= pluralize(@ideas.size, "match") %> · <%= link_to "clear", ideas_path, class: "normal-case tracking-normal text-link hover:underline" %></h2>
    <div id="ideas" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"><%= render @ideas %></div>
  <% else %>
    <% starred, others = @ideas.partition(&:starred) %>
    <% if starred.any? %>
      <h2 class="divider">★ Starred</h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"><%= render starred %></div>
    <% end %>
    <% if others.any? %>
      <h2 class="divider"><%= starred.any? ? "Everything else" : "All ideas" %></h2>
      <div id="ideas" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"><%= render others %></div>
    <% end %>
  <% end %>
<% else %>
  <div class="sheet mt-10 max-w-xl text-center">
    <div class="text-5xl">💡</div>
    <% if @total_count.zero? %>
      <h2 class="mt-4 text-2xl font-black">Every great business starts as a scribble</h2>
      <p class="mt-2 text-stone-500 dark:text-stone-400">Capture your first idea. You can flesh it out later.</p>
      <%= link_to "+ Add your first idea", new_idea_path, class: "btn btn-go mt-6" %>
    <% else %>
      <h2 class="mt-4 text-2xl font-black">Nothing matches that</h2>
      <p class="mt-2 text-stone-500 dark:text-stone-400">Try another search, or <%= link_to "see all your ideas", ideas_path, class: "btn-link" %>.</p>
    <% end %>
  </div>
<% end %>
