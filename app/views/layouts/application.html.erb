<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Idea Vault" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Idea Vault">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-cream font-sans text-ink antialiased dark:bg-night dark:text-stone-100">
    <header class="border-b border-rule bg-paper/90 backdrop-blur dark:border-night-rule dark:bg-night-paper/90">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <%= link_to root_path, class: "flex items-center gap-2 font-black tracking-tight sm:w-32" do %>
          <span class="grid size-8 place-items-center rounded-full bg-amber-300 text-base">💡</span>
          <span class="hidden sm:inline">Idea Vault</span>
        <% end %>
        <nav class="flex items-center gap-1">
          <%= nav_link "Home", root_path, icon: :home, active: current_page?(root_path) && params[:starred] != "1" %>
          <%= nav_link "Starred", ideas_path(starred: "1"), icon: :star, active: params[:starred] == "1" %>
          <%= nav_link "New idea", new_idea_path, icon: :plus, active: current_page?(new_idea_path) %>
        </nav>
        <div class="hidden w-32 sm:block"></div>
      </div>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="pointer-events-none fixed inset-x-0 top-20 z-20 flex justify-center px-4">
        <p class="rounded-full bg-ink px-5 py-2 text-sm font-semibold text-white shadow-lg dark:bg-stone-100 dark:text-ink">
          <%= notice.presence || alert %>
        </p>
      </div>
    <% end %>

    <main class="mx-auto max-w-6xl px-4 py-10">
      <%= yield %>
    </main>
  </body>
</html>
